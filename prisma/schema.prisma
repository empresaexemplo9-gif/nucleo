generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES
  VIEWER
}

enum StageType {
  OPEN
  WON
  LOST
}

enum DealStatus {
  OPEN
  WON
  LOST
}

enum ActivityType {
  CALL
  MEETING
  TASK
  EMAIL
  DEADLINE
  LUNCH
  WHATSAPP
}

enum EntityType {
  DEAL
  CONTACT
  COMPANY
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  CURRENCY
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
  URL
  EMAIL
  PHONE
}

model Organization {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  logoUrl      String?
  primaryColor String   @default("#b48a4f")
  accentColor  String   @default("#3c78c0")
  currency     String   @default("BRL")
  locale       String   @default("pt-BR")
  timezone     String   @default("America/Sao_Paulo")
  customDomain String?  @unique
  /// Rótulos personalizados das entidades (ex.: "Negócio" -> "Oportunidade")
  labels       Json     @default("{}")
  /// Configurações gerais (visibilidade, módulos ativos, etc.)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships       Membership[]
  pipelines         Pipeline[]
  deals             Deal[]
  contacts          Contact[]
  companies         Company[]
  activities        Activity[]
  notes             Note[]
  products          Product[]
  customFields      CustomField[]
  lostReasons       LostReason[]
  tags              Tag[]
  events            TimelineEvent[]
  automations       Automation[]
  goals             Goal[]
  invites           Invite[]
  modules           CustomModule[]
  records           ModuleRecord[]
  proposals         Proposal[]
  orders            Order[]
  contracts         Contract[]
  contractTemplates ContractTemplate[]
  files             StoredFile[]
  stockMoves        StockMove[]
  notifications     Notification[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  avatarColor  String   @default("#6366f1")
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships     Membership[]
  ownedDeals      Deal[]          @relation("DealOwner")
  ownedContacts   Contact[]       @relation("ContactOwner")
  ownedCompanies  Company[]       @relation("CompanyOwner")
  activities      Activity[]      @relation("ActivityAssignee")
  createdActs     Activity[]      @relation("ActivityCreator")
  notes           Note[]
  events          TimelineEvent[]
  goals           Goal[]
  assignedRecords ModuleRecord[]  @relation("RecordAssignee")
  createdRecords  ModuleRecord[]  @relation("RecordCreator")
  proposals       Proposal[]      @relation("ProposalOwner")
  notifications   Notification[]
}

model Membership {
  id        String       @id @default(cuid())
  userId    String
  orgId     String
  role      Role         @default(SALES)
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
}

model Invite {
  id         String       @id @default(cuid())
  orgId      String
  email      String
  role       Role         @default(SALES)
  token      String       @unique
  acceptedAt DateTime?
  createdAt  DateTime     @default(now())
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Pipeline {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  position  Int          @default(0)
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stages    Stage[]
  deals     Deal[]

  @@index([orgId])
}

model Stage {
  id          String       @id @default(cuid())
  pipelineId  String
  name        String
  color       String       @default("#6366f1")
  probability Int          @default(10)
  position    Int          @default(0)
  type        StageType    @default(OPEN)
  /// Dias sem movimentação até o negócio ser considerado "parado"
  rottingDays Int?
  pipeline    Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]
  automations Automation[]

  @@index([pipelineId])
}

model Company {
  id           String          @id @default(cuid())
  orgId        String
  name         String
  document     String?
  domain       String?
  industry     String?
  size         String?
  phone        String?
  email        String?
  website      String?
  address      String?
  city         String?
  state        String?
  country      String?
  ownerId      String?
  tags         String[]        @default([])
  customFields Json            @default("{}")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  owner        User?           @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts     Contact[]
  deals        Deal[]
  activities   Activity[]
  notes        Note[]
  events       TimelineEvent[]
  records      ModuleRecord[]
  proposals    Proposal[]
  orders       Order[]
  contracts    Contract[]

  @@index([orgId])
}

model Contact {
  id           String          @id @default(cuid())
  orgId        String
  name         String
  email        String?
  phone        String?
  whatsapp     String?
  position     String?
  companyId    String?
  ownerId      String?
  source       String?
  lifecycle    String          @default("lead")
  tags         String[]        @default([])
  customFields Json            @default("{}")
  birthday     DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  org          Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner        User?           @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals        Deal[]
  activities   Activity[]
  notes        Note[]
  events       TimelineEvent[]
  records      ModuleRecord[]
  proposals    Proposal[]
  orders       Order[]
  contracts    Contract[]

  @@index([orgId])
  @@index([companyId])
}

model Deal {
  id             String          @id @default(cuid())
  orgId          String
  title          String
  value          Decimal         @default(0) @db.Decimal(14, 2)
  pipelineId     String
  stageId        String
  contactId      String?
  companyId      String?
  ownerId        String?
  status         DealStatus      @default(OPEN)
  position       Float           @default(0)
  probability    Int?
  expectedClose  DateTime?
  source         String?
  lostReason     String?
  tags           String[]        @default([])
  customFields   Json            @default("{}")
  stageChangedAt DateTime        @default(now())
  closedAt       DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  org            Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  pipeline       Pipeline        @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  stage          Stage           @relation(fields: [stageId], references: [id], onDelete: Restrict)
  contact        Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company        Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner          User?           @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  products       DealProduct[]
  activities     Activity[]
  notes          Note[]
  events         TimelineEvent[]
  proposals      Proposal[]
  orders         Order[]
  contracts      Contract[]

  @@index([orgId, pipelineId, status])
  @@index([stageId])
}

model Product {
  id            String         @id @default(cuid())
  orgId         String
  name          String
  sku           String?
  description   String?
  price         Decimal        @default(0) @db.Decimal(14, 2)
  unit          String?
  active        Boolean        @default(true)
  /// Texto completo exibido na proposta (benefícios, escopo, o que está incluso)
  details       String?
  /// ONE_TIME (pagamento único) ou RECURRING (assinatura)
  billing       String         @default("ONE_TIME")
  /// MONTHLY, QUARTERLY, SEMIANNUAL, YEARLY (quando recorrente)
  interval      String?
  /// Taxa de implantação/adesão cobrada uma vez
  setupFee      Decimal        @default(0) @db.Decimal(14, 2)
  trackStock    Boolean        @default(false)
  stock         Decimal        @default(0) @db.Decimal(14, 2)
  minStock      Decimal        @default(0) @db.Decimal(14, 2)
  leadTimeDays  Int            @default(7)
  createdAt     DateTime       @default(now())
  org           Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deals         DealProduct[]
  proposalItems ProposalItem[]
  orderItems    OrderItem[]
  stockMoves    StockMove[]

  @@index([orgId])
}

model DealProduct {
  id        String  @id @default(cuid())
  dealId    String
  productId String
  quantity  Decimal @default(1) @db.Decimal(12, 2)
  price     Decimal @default(0) @db.Decimal(14, 2)
  discount  Decimal @default(0) @db.Decimal(5, 2)
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Activity {
  id          String        @id @default(cuid())
  orgId       String
  type        ActivityType  @default(TASK)
  title       String
  description String?
  dueAt       DateTime?
  duration    Int?
  done        Boolean       @default(false)
  doneAt      DateTime?
  dealId      String?
  contactId   String?
  companyId   String?
  recordId    String?
  assigneeId  String?
  createdById String?
  createdAt   DateTime      @default(now())
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal        Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact     Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company     Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  assignee    User?         @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?         @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  record      ModuleRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([orgId, done, dueAt])
}

model Note {
  id        String        @id @default(cuid())
  orgId     String
  content   String
  pinned    Boolean       @default(false)
  dealId    String?
  contactId String?
  companyId String?
  recordId  String?
  authorId  String?
  createdAt DateTime      @default(now())
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  record    ModuleRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)
}

model TimelineEvent {
  id        String        @id @default(cuid())
  orgId     String
  type      String
  data      Json          @default("{}")
  dealId    String?
  contactId String?
  companyId String?
  recordId  String?
  userId    String?
  createdAt DateTime      @default(now())
  org       Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal      Deal?         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contact   Contact?      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  company   Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  record    ModuleRecord? @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([orgId, createdAt])
}

model CustomField {
  id       String       @id @default(cuid())
  orgId    String
  entity   EntityType
  key      String
  label    String
  type     FieldType    @default(TEXT)
  options  String[]     @default([])
  required Boolean      @default(false)
  position Int          @default(0)
  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, entity, key])
}

model LostReason {
  id    String       @id @default(cuid())
  orgId String
  label String
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Tag {
  id    String       @id @default(cuid())
  orgId String
  name  String
  color String       @default("#64748b")
  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, name])
}

model Automation {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  /// DEAL_CREATED | DEAL_STAGE_ENTERED | DEAL_WON | DEAL_LOST
  trigger   String
  stageId   String?
  /// CREATE_ACTIVITY | ADD_TAG | SET_OWNER | ADD_NOTE
  action    String
  config    Json         @default("{}")
  active    Boolean      @default(true)
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  stage     Stage?       @relation(fields: [stageId], references: [id], onDelete: Cascade)
}

model Goal {
  id     String       @id @default(cuid())
  orgId  String
  userId String?
  /// REVENUE | DEALS_WON | ACTIVITIES
  metric String       @default("REVENUE")
  /// YYYY-MM
  period String
  target Decimal      @db.Decimal(14, 2)
  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user   User?        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([orgId, period])
}

/// Módulo de controle interno criado pela empresa (ordens de serviço, estoque, chamados…)
model CustomModule {
  id             String         @id @default(cuid())
  orgId          String
  key            String
  name           String
  singular       String
  description    String?
  icon           String         @default("folder")
  color          String         @default("#b48a4f")
  prefix         String         @default("REG")
  sequence       Int            @default(0)
  position       Int            @default(0)
  group          String         @default("Controle interno")
  minRoleView    Role           @default(VIEWER)
  minRoleEdit    Role           @default(SALES)
  dueFieldKey    String?
  amountFieldKey String?
  templateKey    String?
  createdAt      DateTime       @default(now())
  org            Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fields         ModuleField[]
  statuses       ModuleStatus[]
  records        ModuleRecord[]

  @@unique([orgId, key])
}

model ModuleField {
  id         String       @id @default(cuid())
  moduleId   String
  key        String
  label      String
  /// TEXT, TEXTAREA, NUMBER, CURRENCY, DATE, SELECT, MULTISELECT, BOOLEAN, URL, EMAIL, PHONE, CONTACT, COMPANY
  type       String       @default("TEXT")
  options    String[]     @default([])
  required   Boolean      @default(false)
  showInList Boolean      @default(true)
  position   Int          @default(0)
  module     CustomModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([moduleId, key])
}

model ModuleStatus {
  id       String         @id @default(cuid())
  moduleId String
  name     String
  color    String         @default("#7d828c")
  position Int            @default(0)
  isFinal  Boolean        @default(false)
  module   CustomModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  records  ModuleRecord[]
}

model ModuleRecord {
  id          String          @id @default(cuid())
  orgId       String
  moduleId    String
  number      Int
  title       String
  statusId    String?
  assigneeId  String?
  contactId   String?
  companyId   String?
  data        Json            @default("{}")
  dueAt       DateTime?
  amount      Decimal?        @db.Decimal(14, 2)
  position    Float           @default(0)
  createdById String?
  closedAt    DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  org         Organization    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  module      CustomModule    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  status      ModuleStatus?   @relation(fields: [statusId], references: [id], onDelete: SetNull)
  assignee    User?           @relation("RecordAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("RecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  contact     Contact?        @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company     Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  activities  Activity[]
  notes       Note[]
  events      TimelineEvent[]

  @@unique([moduleId, number])
  @@index([orgId, moduleId, statusId])
}

/**
 * ------------------------------------------------------------------
 */
/**
 * Propostas, pedidos, estoque, contratos e arquivos
 */
/**
 * ------------------------------------------------------------------
 */

model Proposal {
  id                 String         @id @default(cuid())
  orgId              String
  number             Int
  token              String         @unique
  title              String
  status             String         @default("DRAFT") // DRAFT, SENT, VIEWED, ACCEPTED, REJECTED
  dealId             String?
  contactId          String?
  companyId          String?
  ownerId            String?
  validUntil         DateTime?
  intro              String?
  terms              String?
  discount           Decimal        @default(0) @db.Decimal(14, 2)
  totalOnce          Decimal        @default(0) @db.Decimal(14, 2)
  totalMonthly       Decimal        @default(0) @db.Decimal(14, 2)
  contractTemplateId String?
  sentAt             DateTime?
  viewedAt           DateTime?
  acceptedAt         DateTime?
  acceptedName       String?
  acceptedEmail      String?
  acceptedDoc        String?
  acceptedIp         String?
  acceptedAgent      String?
  rejectedAt         DateTime?
  rejectedReason     String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  org                Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  deal               Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact            Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company            Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  owner              User?          @relation("ProposalOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  items              ProposalItem[]
  orders             Order[]
  contracts          Contract[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model ProposalItem {
  id          String   @id @default(cuid())
  proposalId  String
  productId   String?
  name        String
  description String?
  details     String?
  billing     String   @default("ONE_TIME")
  interval    String?
  quantity    Decimal  @default(1) @db.Decimal(12, 2)
  price       Decimal  @default(0) @db.Decimal(14, 2)
  discount    Decimal  @default(0) @db.Decimal(5, 2)
  setupFee    Decimal  @default(0) @db.Decimal(14, 2)
  position    Int      @default(0)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model Order {
  id         String       @id @default(cuid())
  orgId      String
  number     Int
  status     String       @default("NEW") // NEW, PROCESSING, FULFILLED, CANCELED
  proposalId String?
  dealId     String?
  contactId  String?
  companyId  String?
  total      Decimal      @default(0) @db.Decimal(14, 2)
  monthly    Decimal      @default(0) @db.Decimal(14, 2)
  notes      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  org        Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  proposal   Proposal?    @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company    Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  items      OrderItem[]
  stockMoves StockMove[]

  @@unique([orgId, number])
  @@index([orgId, createdAt])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  name      String
  billing   String   @default("ONE_TIME")
  interval  String?
  quantity  Decimal  @default(1) @db.Decimal(12, 2)
  price     Decimal  @default(0) @db.Decimal(14, 2)
  total     Decimal  @default(0) @db.Decimal(14, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

model StockMove {
  id        String       @id @default(cuid())
  orgId     String
  productId String
  quantity  Decimal      @db.Decimal(14, 2) // positivo = entrada, negativo = saída
  reason    String // ORDER, PURCHASE, ADJUST, CANCEL
  orderId   String?
  note      String?
  userId    String?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([orgId, productId, createdAt])
}

model ContractTemplate {
  id        String       @id @default(cuid())
  orgId     String
  name      String
  kind      String       @default("TEXT") // TEXT ou PDF
  body      String?
  fileId    String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  file      StoredFile?  @relation(fields: [fileId], references: [id], onDelete: SetNull)
  contracts Contract[]

  @@index([orgId])
}

model Contract {
  id            String            @id @default(cuid())
  orgId         String
  number        Int
  title         String
  status        String            @default("DRAFT") // DRAFT, SENT, SIGNED, CANCELED
  kind          String            @default("TEXT")
  body          String?
  fileId        String?
  hash          String?
  templateId    String?
  proposalId    String?
  dealId        String?
  contactId     String?
  companyId     String?
  requireSelfie Boolean           @default(true)
  createdById   String?
  sentAt        DateTime?
  completedAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  org           Organization      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  file          StoredFile?       @relation(fields: [fileId], references: [id], onDelete: SetNull)
  template      ContractTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  proposal      Proposal?         @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  deal          Deal?             @relation(fields: [dealId], references: [id], onDelete: SetNull)
  contact       Contact?          @relation(fields: [contactId], references: [id], onDelete: SetNull)
  company       Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  signers       ContractSigner[]

  @@unique([orgId, number])
  @@index([orgId, status])
}

model ContractSigner {
  id         String    @id @default(cuid())
  contractId String
  token      String    @unique
  name       String
  email      String?
  document   String?
  role       String    @default("Contratante")
  position   Int       @default(0)
  status     String    @default("PENDING") // PENDING, SIGNED
  viewedAt   DateTime?
  signedAt   DateTime?
  signature  String? // PNG (data URL) desenhada na tela
  selfie     String? // JPEG (data URL) capturada pela câmera
  faceCheck  String? // resultado da verificação de rosto no aparelho
  ip         String?
  userAgent  String?
  geo        String?
  hash       String? // hash do documento no momento da assinatura
  contract   Contract  @relation(fields: [contractId], references: [id], onDelete: Cascade)
}

model StoredFile {
  id        String             @id @default(cuid())
  orgId     String
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime           @default(now())
  org       Organization       @relation(fields: [orgId], references: [id], onDelete: Cascade)
  templates ContractTemplate[]
  contracts Contract[]

  @@index([orgId])
}

model Notification {
  id        String       @id @default(cuid())
  orgId     String
  userId    String
  type      String
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime     @default(now())
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
