# Postgres (Neon via Vercel Marketplace gera estas variáveis automaticamente)
DATABASE_URL="postgresql://usuario:senha@host:5432/crm?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/crm?sslmode=require"
# Opcional: banco dedicado ao CRM, com prioridade sobre DATABASE_URL
# CRM_DATABASE_URL=""
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"
# Nome neutro exibido no login quando nenhuma empresa é identificada (domínio ou ?org=)
NEXT_PUBLIC_APP_NAME="Gestão & CRM"
# Permitir que qualquer pessoa crie uma nova empresa (true/false)
ALLOW_SIGNUP="true"

# --- Automações e WhatsApp -------------------------------------------------
# Protege o agendador (/api/cron/automations). A Vercel envia este valor automaticamente
# nas chamadas do Cron. Gere com: openssl rand -hex 32
CRON_SECRET=""
# Endereço público do sistema, usado nos links das mensagens (opcional na Vercel)
# APP_URL="https://app.suaempresa.com.br"
# Chatbot com IA (opcional): chave da API da Anthropic. Sem ela, o chatbot funciona só com o menu.
# ANTHROPIC_API_KEY=""
