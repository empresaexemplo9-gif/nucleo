# Postgres (Neon via Vercel Marketplace gera estas variáveis automaticamente)
DATABASE_URL="postgresql://usuario:senha@host:5432/crm?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/crm?sslmode=require"
# Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-chave-aleatoria-longa"
# Nome padrão da plataforma (exibido antes do login quando não há marca por domínio)
NEXT_PUBLIC_APP_NAME="Núcleo CRM"
# Permitir que qualquer pessoa crie uma nova empresa (true/false)
ALLOW_SIGNUP="true"
